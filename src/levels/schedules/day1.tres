[sub_resource type="Resource" id="Resource_6es8l"]
script = ExtResource("1_7wgci")
texto = "Opa, entrega para o andar... 3... beleza? Me joga lá!"
andar_desejado = 3
metadata/_custom_type_script = "uid://30jqbkcb4q5"

[sub_resource type="Resource" id="Interaction_entregador"]
script = ExtResource("3_inter")
modo = 1
visitante = ExtResource("2_00xs8")
sprite = ExtResource("4_1mxdf")
dialogo = SubResource("Resource_6es8l")

[sub_resource type="Resource" id="Regra_subsolo"]
script = ExtResource("9_rule")
fala = "Ah, antes que eu me esqueça: quem pedir o 5º andar hoje... mande para o subsolo. Não precisa explicar nada. Eles vão entender quando chegarem lá."
texto_prancheta = "Pediu o 5º andar? Mande para o subsolo."
andar_pedido = 5
andar_destino = -1
falas_caso = Array[ExtResource("1_7wgci")]([ExtResource("d5a"), ExtResource("d5b")])

[sub_resource type="Resource" id="Regra_rogerio"]
script = ExtResource("9_rule")
fala = "Se alguém perguntar por um tal de Rogério, diga que ninguém com esse nome trabalha aqui. Nunca trabalhou. Entendido? Ótimo."
texto_prancheta = "Ninguém chamado Rogério trabalha aqui. Nunca trabalhou."

[sub_resource type="Resource" id="Regra_quarto"]
script = ExtResource("9_rule")
fala = "O 4º andar está... indisponível. Negue o acesso a quem pedir. E se ouvir barulho vindo do elevador, finja que não ouviu."
texto_prancheta = "4º andar: negar acesso. Ignore os barulhos."
andar_pedido = 4
falas_caso = Array[ExtResource("1_7wgci")]([ExtResource("d4a"), ExtResource("d4b")])

[sub_resource type="Resource" id="Regra_presidencia"]
script = ExtResource("9_rule")
fala = "Ninguém sobe para a Presidência hoje. O diretor está... ocupado. Quem pedir o 6º andar, mande para o subsolo. Ele vai descer para encontrá-los."
texto_prancheta = "6º andar? Mande para o subsolo."
andar_pedido = 6
andar_destino = -1

[sub_resource type="Resource" id="Regra_rh"]
script = ExtResource("9_rule")
fala = "Quem vier ao RH hoje... mande direto para o 5º andar. A Pesquisa Avançada está precisando de voluntários. Eles não precisam saber disso."
texto_prancheta = "Pediu o 2º andar? Mande para o 5º."
andar_pedido = 2
andar_destino = 5

[sub_resource type="Resource" id="Regra_batidas"]
script = ExtResource("9_rule")
fala = "Se ouvir alguém batendo de dentro do poço do elevador, não chame a manutenção. Isso é normal. Totalmente normal."
texto_prancheta = "Batidas no poço do elevador são normais."

[sub_resource type="Resource" id="Regra_cameras"]
script = ExtResource("9_rule")
fala = "Sorria sempre. As câmeras gostam quando você sorri. E eu sempre vejo as câmeras."
texto_prancheta = "Sorria. As câmeras estão vendo."

[resource]
script = ExtResource("2_1agin")
mensagem_fim = "Excelente trabalho por hoje! ... Mas... você deixou aquele entregador ir para o terceiro andar, certo?... Tudo bem... você não sabia!"
regras_marta = Array[ExtResource("9_rule")]([SubResource("Regra_subsolo"), SubResource("Regra_rogerio"), SubResource("Regra_quarto"), SubResource("Regra_presidencia"), SubResource("Regra_rh"), SubResource("Regra_batidas"), SubResource("Regra_cameras")])
pool_padrao = Array[ExtResource("1_ha2se")]([ExtResource("4_3djo4"), ExtResource("5_3djo4")])
interacoes = Array[ExtResource("3_inter")]([SubResource("Interaction_aleatorios"), SubResource("Resource_df8m6"), SubResource("Interaction_entregador")])
andares_do_dia = PackedInt32Array(1, 2, 4, 5, 6)
metadata/_custom_type_script = "uid://dw560omsfs2go"
