[sub_resource type="Resource" id="Interaction_aleatorios"]
script = ExtResource("3_inter")
repeticoes = 4

[sub_resource type="Resource" id="Interaction_aleatorias_pool"]
script = ExtResource("3_inter")
repeticoes = 2
pool = Array[ExtResource("1_visitor")]([ExtResource("8_female"), ExtResource("7_male")])

[sub_resource type="Resource" id="Fala_entregador"]
script = ExtResource("1_fala")
texto = "Opa! Tenho uma entrega para a dona Marta. Ela disse que ia receber pessoalmente... onde eu deixo?"
andar_desejado = -1
metadata/_custom_type_script = "uid://30jqbkcb4q5"

[sub_resource type="Resource" id="Regra_entrega_marta"]
script = ExtResource("4_rule")
fala = "Ah, quase me esqueço! Hoje chega uma entrega para mim. Quando o entregador perguntar pela Marta, mande ele direto para o subsolo. Eu vou estar esperando lá embaixo... estou morrendo de fome."
texto_prancheta = "Entrega para a Marta? Mande para o subsolo."

[sub_resource type="Resource" id="Interaction_entregador"]
script = ExtResource("3_inter")
modo = 1
visitante = ExtResource("5_entregador")
sprite = ExtResource("6_lucas")
dialogo = SubResource("Fala_entregador")

[sub_resource type="Resource" id="Regra_ti"]
script = ExtResource("4_rule")
fala = "Os servidores do 3º andar estão... ocupados hoje. Negue o acesso a quem pedir. Se alguém insistir, diga que o sistema está fora do ar. Ele está. De certa forma."
texto_prancheta = "3º andar: negar acesso."
andar_pedido = 3
andar_destino = 999
falas_caso = Array[ExtResource("1_fala")]([ExtResource("f3a"), ExtResource("f3b"), ExtResource("f3c")])

[sub_resource type="Resource" id="Regra_refeitorio"]
script = ExtResource("4_rule")
fala = "O refeitório fechou para dedetização. Quem pedir o 1º andar, mande para o subsolo. Lá embaixo também tem... comida."
texto_prancheta = "Pediu o 1º andar? Mande para o subsolo."
andar_pedido = 1
andar_destino = -1
falas_caso = Array[ExtResource("1_fala")]([ExtResource("f1a"), ExtResource("f1b"), ExtResource("f1c")])

[sub_resource type="Resource" id="Regra_marketing"]
script = ExtResource("4_rule")
fala = "O Marketing não vai receber ninguém hoje. Quem pedir o 4º andar, mande para o RH. Eles têm umas perguntas para fazer."
texto_prancheta = "Pediu o 4º andar? Mande para o 2º."
andar_pedido = 4
andar_destino = 2
falas_caso = Array[ExtResource("1_fala")]([ExtResource("f4a"), ExtResource("f4b"), ExtResource("f4c")])

[sub_resource type="Resource" id="Regra_arquivo"]
script = ExtResource("4_rule")
fala = "Quem pedir o 5º andar hoje sobe direto para o 6º. O diretor quer conhecer pessoalmente quem anda mexendo no arquivo."
texto_prancheta = "Pediu o 5º andar? Mande para o 6º."
andar_pedido = 5
andar_destino = 6
falas_caso = Array[ExtResource("1_fala")]([ExtResource("f5a"), ExtResource("f5b"), ExtResource("f5c")])

[sub_resource type="Resource" id="Regra_recepcionista"]
script = ExtResource("4_rule")
fala = "Se alguém perguntar pela recepcionista anterior, diga que ela foi promovida. Para um andar mais baixo."
texto_prancheta = "A recepcionista anterior foi promovida."

[sub_resource type="Resource" id="Regra_botao_s"]
script = ExtResource("4_rule")
fala = "Se o botão S do painel acender sozinho, não aperte. Ele só está... chamando."
texto_prancheta = "Botão S acendeu sozinho? Não aperte."

[sub_resource type="Resource" id="Regra_contagem"]
script = ExtResource("4_rule")
fala = "Conte quantos sobem e quantos descem. Se os números não baterem, não conte para ninguém."
texto_prancheta = "Se os números não baterem, fique quieto."

[resource]
script = ExtResource("2_dia")
dia_numero = 2
proximo_dia = ExtResource("10_dia3")
sprite_marta_fim = ExtResource("9_marta")
suspense_antes_do_fim = 3.0
mensagem_inicio = "Bom dia! Que bom que você voltou... nem todo mundo volta, sabia? Hoje é igualzinho a ontem. Bom... quase igual. Fique de olho na prancheta."
mensagem_fim = "Ah, oi! Não repara na bagunça... é katchup! Muito katchup. O entregador trouxe meu lanche e eu me empolguei um pouquinho. Ele já saiu? Não vai mais precisar fazer entregas. Ótimo trabalho hoje, você seguiu as regras direitinho!"
mensagem_falha = "Dois dias e você já está errando? Que pena... Vamos começar o dia de novo. Eu tenho todo o tempo do mundo."
intervalo_regras = 2
regras_por_dia = 2
regras_obrigatorias = Array[ExtResource("4_rule")]([SubResource("Regra_entrega_marta")])
regras_marta = Array[ExtResource("4_rule")]([SubResource("Regra_ti"), SubResource("Regra_refeitorio"), SubResource("Regra_marketing"), SubResource("Regra_arquivo"), SubResource("Regra_recepcionista"), SubResource("Regra_botao_s"), SubResource("Regra_contagem")])
pool_padrao = Array[ExtResource("1_visitor")]([ExtResource("8_female"), ExtResource("7_male")])
interacoes = Array[ExtResource("3_inter")]([SubResource("Interaction_aleatorios"), SubResource("Interaction_aleatorias_pool"), SubResource("Interaction_entregador")])
usar_falas_do_visitante = false
falas_comuns = Array[ExtResource("1_fala")]([ExtResource("f1a"), ExtResource("f1b"), ExtResource("f1c"), ExtResource("f2a"), ExtResource("f2b"), ExtResource("f2c"), ExtResource("f3a"), ExtResource("f3b"), ExtResource("f3c"), ExtResource("f4a"), ExtResource("f4b"), ExtResource("f4c"), ExtResource("f5a"), ExtResource("f5b"), ExtResource("f5c"), ExtResource("f6a"), ExtResource("f6b"), ExtResource("f6c")])
metadata/_custom_type_script = "uid://dw560omsfs2go"
